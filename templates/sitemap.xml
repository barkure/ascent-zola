{#- Zola's default sitemap plus one filter: pages that only exist to redirect an
    older URL (`extra.redirect_to`, generated by tools/migrate-from-hexo.mjs)
    are not part of the canonical site. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {%- for sitemap_entry in entries %}
    {%- if not sitemap_entry.extra?.redirect_to %}
    <url>
        <loc>{{ sitemap_entry.permalink | escape_xml | safe }}</loc>
        {%- if sitemap_entry.updated %}
        <lastmod>{{ sitemap_entry.updated }}</lastmod>
        {%- endif %}
    </url>
    {%- endif %}
    {%- endfor %}
</urlset>
